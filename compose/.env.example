# Panda standard production configuration.
# Copy this file to the environment file used by Compose and replace each CHANGE_ME value.
# Optional settings are listed in compose/.env.full.example and documented at
# https://docs.panda.invalid/docs/reference/environment-variables/

# Required: select the digest of the image built and tested from this source.
# PANDA_IMAGE=ghcr.io/your-account/panda@sha256:REPLACE_WITH_REVIEWED_DIGEST
# Use PANDA_IMAGE=panda:local only with docker-compose.build.yml.
# Required: provision JWT_SECRET, JWT_PUBLIC_KEY, AGE_ENCRYPTION_KEY externally.
# Prefer the key-file overlay; see docs/runbooks/key-custody.md before upgrading.
# PANDA_KEYS_SOURCE=/absolute/path/outside-app-data/panda-keys
# docker compose also needs -f compose/docker-compose.keys.yml for that mount.

POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
ALLOWED_ORIGINS=https://panda.example.net
# New installations use Docker-managed volumes. Existing installations that do
# not set these variables continue to use PANDA_DATA_DIR/../data bind paths.
PANDA_DB_SOURCE=panda-db
PANDA_REDIS_SOURCE=panda-redis
PANDA_BACKUPS_SOURCE=panda-backups
PANDA_CACHE_SOURCE=panda-cache
PANDA_HOST_BIND_ADDRESS=127.0.0.1
PANDA_ORIGIN_PORT=8080
PANDA_BIND_ADDRESS=127.0.0.1
# PANDA_SETUP_TOKEN=replace-with-at-least-32-random-bytes
# LAN-only HTTP login is insecure. Leave false unless following the documented
# private-network-only procedure: https://docs.panda.invalid/docs/operations/secure-remote-access/
ALLOW_INSECURE_LAN_HTTP_AUTH=false
TZ=UTC
