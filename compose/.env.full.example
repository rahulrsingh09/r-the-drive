# Panda complete environment reference
#
# Production requires external application keys and an explicitly selected image.
# Uncomment optional values only when overriding a documented default. The
# published reference is https://docs.panda.invalid/docs/reference/environment-variables/

# Standard production installation
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
ALLOWED_ORIGINS=https://panda.example.net
# POSTGRES_USER=panda
# DATABASE_URL=postgresql://panda:password@timescaledb:5432/panda
# REDIS_URL=redis://default:password@redis:6379

# Image and Compose behavior
# PANDA_IMAGE=ghcr.io/your-account/panda@sha256:replace-with-reviewed-source-image-digest
# PANDA_ORIGIN_PORT=8080
# PANDA_HOST_BIND_ADDRESS=127.0.0.1
# PANDA_BIND_ADDRESS=127.0.0.1
# ALLOW_PUBLIC_ORIGIN_BIND=false
# LAN-only HTTP login is insecure. It requires ALLOW_PUBLIC_ORIGIN_BIND=true,
# a private/loopback/link-local literal HTTP ALLOWED_ORIGINS value, and the
# documented trusted-network firewall boundary.
# ALLOW_INSECURE_LAN_HTTP_AUTH=false
# PANDA_ENV_FILE=../.env
# PANDA_DATA_DIR=../data
# PANDA_DB_SOURCE=panda-db
# PANDA_REDIS_SOURCE=panda-redis
# PANDA_BACKUPS_SOURCE=panda-backups
# PANDA_CACHE_SOURCE=panda-cache

# Required externally managed application keys. Supply all three in production.
# For each key, choose the direct value OR its _FILE alternative, never both.
# Only explicit local development can generate database-backed keys.
# JWT_SECRET=-----BEGIN PRIVATE KEY-----...
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# AGE_ENCRYPTION_KEY=AGE-SECRET-KEY-1...
# JWT_SECRET_FILE=/run/secrets/panda/jwt_private.pem
# JWT_PUBLIC_KEY_FILE=/run/secrets/panda/jwt_public.pem
# AGE_ENCRYPTION_KEY_FILE=/run/secrets/panda/age_key.txt
# Host directory consumed by compose/docker-compose.keys.yml only.
# PANDA_KEYS_SOURCE=/absolute/path/outside-app-data/panda-keys
# PANDA_SETUP_TOKEN=replace-with-at-least-32-random-bytes
# PANDA_SETUP_TOKEN_FILE=/run/secrets/panda-setup-token

# Optional OIDC/SSO authentication overrides. SSO and password login are
# disabled/enabled independently. Database settings in Settings > Authentication
# remain the primary path; an uncommented value overrides that field only.
# These values are passed by standard Compose through the root .env file.
# Keep the direct client secret in PANDA_OIDC_CLIENT_SECRET for this path.
# The _FILE and _SOURCE values below are for the optional
# compose/docker-compose.oidc-secret.yml overlay only; do not uncomment them
# unless that overlay mounts the corresponding host file into the container.
# PANDA_OIDC_ENABLED=false
# PANDA_PASSWORD_LOGIN_ENABLED=true
# PANDA_OIDC_AUTO_LOGIN=false
# PANDA_OIDC_ISSUER_URL=https://auth.example.net/application/o/panda/
# PANDA_OIDC_PUBLIC_BASE_URL=https://panda.example.net
# PANDA_OIDC_CLIENT_ID=replace-with-client-id
# PANDA_OIDC_CLIENT_SECRET=replace-with-client-secret
# Optional overlay-only secret-file settings; use these instead of the direct
# secret, never together with it.
# PANDA_OIDC_CLIENT_SECRET_FILE=/run/secrets/panda-oidc-client-secret
# Host path consumed only by compose/docker-compose.oidc-secret.yml.
# PANDA_OIDC_CLIENT_SECRET_SOURCE=../secrets/panda-oidc-client-secret
# PANDA_OIDC_BUTTON_LABEL=Sign in with SSO
# PANDA_OIDC_SCOPES=openid email profile
# PANDA_OIDC_TOKEN_AUTH_METHOD=auto
# PANDA_OIDC_AUTO_SIGNUP=false
# PANDA_OIDC_AUTO_LINK_VERIFIED_EMAIL=false
# PANDA_OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# PANDA_OIDC_REQUIRED_CLAIM_NAME=groups
# PANDA_OIDC_REQUIRED_CLAIM_VALUE=panda-users
# PANDA_OIDC_CLIENT_SECRET and _FILE are mutually exclusive. The standard
# Compose file does not mount _FILE; an uncommented _FILE without the overlay
# will fail startup when the container cannot read the path.

# Application runtime
# TZ=UTC
# PANDA_ENV=production
# PORT=3001
# RUST_LOG=info
# COOKIE_INSECURE=true  # local development only; leave unset for production
# VEHICLE_IMAGE_CACHE_DIR=/data/cache/panda/vehicle-images
# BACKUP_DRIVER=pg_dump
# BACKUP_ARTIFACT_DIR=/backups
# BACKUP_POLL_INTERVAL_SECONDS=60
# CHARGE_IDENTITY_BACKFILL_BATCH_SIZE=1000
# CHARGE_IDENTITY_BACKFILL_PAUSE_MS=100
# RESTORE_AGENT_URL=http://127.0.0.1:3002
# RESTORE_AGENT_KEY_FILE=/backups/.restore-agent-key
# RECOVERY_MAX_UPLOAD_BYTES=17179869184
# RECOVERY_MAX_EXPANDED_BYTES=68719476736
# RECOVERY_MAX_MEMBER_BYTES=68719476736
# RECOVERY_MAX_MANIFEST_BYTES=1048576
# RECOVERY_MAX_SETTINGS_BYTES=1048576
# RECOVERY_MAX_HISTORY_BYTES=16777216
# RECOVERY_MAX_MEMBERS=10000
# RECOVERY_MAX_COMPRESSION_RATIO=200
# RECOVERY_MIN_FREE_BYTES=2147483648
# RECOVERY_UPLOAD_DEADLINE_SECONDS=1800
# RECOVERY_RESTORE_DEADLINE_SECONDS=14400

# Optional credential/endpoint fallbacks for Settings-managed S3 backups.
# S3_ENDPOINT=https://s3.example.net
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME

# Rivian connection and telemetry behavior
# RIVIAN_GRAPHQL_GATEWAY_URL=https://rivian.com/api/gql/gateway/graphql
# RIVIAN_WS_RECONNECT_INITIAL_SECONDS=10
# RIVIAN_WS_RECONNECT_MAX_SECONDS=900
# RIVIAN_RAW_EVENT_RETENTION_DAYS=7
# RIVIAN_PERSIST_RAW_EVENTS=true
# RIVIAN_SUPPRESS_DUPLICATE_TELEMETRY=true
# Extended Parallax acquisition runs inside each vehicle worker by default.
# Set false only as an emergency rollback; no separate collector is required.
# PARALLAX_ENABLED=true

# API rate limits
# RATE_LIMIT_AUTH_PUBLIC_PER_MINUTE=30
# RATE_LIMIT_AUTH_PUBLIC_BURST=10
# RATE_LIMIT_AUTH_METADATA_PER_MINUTE=1200
# RATE_LIMIT_AUTH_METADATA_BURST=120
# RATE_LIMIT_AUTH_READ_PER_MINUTE=900
# RATE_LIMIT_AUTH_READ_BURST=180
# RATE_LIMIT_AUTH_WRITE_PER_MINUTE=240
# RATE_LIMIT_AUTH_WRITE_BURST=60
# RATE_LIMIT_HEAVY_READ_PER_MINUTE=300
# RATE_LIMIT_HEAVY_READ_BURST=90

# Local development stack. These do not change production Compose.
# The dev Compose file already sets PANDA_ENV=development and
# COOKIE_INSECURE=true so HTTP page reloads preserve the browser session.
# DEV_API_PORT=3001
# DEV_WEB_PORT=5173
# DEV_POSTGRES_PORT=5432
# DEV_REDIS_PORT=6379
# DEV_GARAGE_PORT=3900
# DEV_GARAGE_ADMIN_PORT=3903
# DEV_WEB_ORIGINS=http://localhost:5173
# DEV_COMPOSE_PROJECT_NAME=panda
# DEV_DATABASE_READY_TIMEOUT_SECONDS=600
# DEV_CARGO_BUILD_JOBS=4
# COMPOSE_PROJECT_NAME=panda

# Frontend development and contract tests
# VITE_PANDA_API_BASE_URL=http://localhost:3001
# VITE_PANDA_DEV_API_KEY=panda_REPLACE_ME
# VITE_PANDA_RUN_LIVE_CONTRACT=0
# VITE_API_URL=http://localhost:3001
# VITE_WS_URL=http://localhost:3001

# Security resource controls and operator-owned private endpoint exceptions.
# WS_MAX_PER_USER=8
# WS_MAX_PER_VEHICLE=32
# WS_MAX_GLOBAL=128
# METRICS_MAX_PER_USER=4
# METRICS_MAX_GLOBAL=8
# METRICS_TIMEOUT_SECONDS=600
# BASEMAP_CACHE_MAX_BYTES=134217728
# BASEMAP_CACHE_TTL_SECONDS=604800
# REDIS_MAXMEMORY=192mb
# WEATHER_MAX_RESPONSE_BYTES=10485760
# RIVIAN_MAX_RESPONSE_BYTES=10485760
# GEOCODER_MAX_RESPONSE_BYTES=2097152
# OIDC_MAX_RESPONSE_BYTES=2097152
# OIDC_PRIVATE_NETWORK_ALLOWLIST=192.168.1.10/32
# S3_PRIVATE_NETWORK_ALLOWLIST=192.168.1.20/32
# S3_ALLOW_INSECURE_PRIVATE_HTTP=false
# S3_ALLOW_DEVELOPMENT_GARAGE=false
# DEV_HOST_BIND_ADDRESS=127.0.0.1
